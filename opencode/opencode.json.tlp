{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemma4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemma 4 31B",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "gemma4-31b": {
          "name": "Gemma 4 31B Dense",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "llama-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Qwen3.6-35B A3B MTP UD (Q4_K_XL)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-mtp": {
          "name": "Qwen3.6-35B A3B MTP (131K)",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "llama-35b-mxfp4-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Qwen3.6-35B A3B MXFP4-MTP (Blackwell FP4, spec decode n=6)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-mxfp4-mtp": {
          "name": "Qwen3.6-35B A3B MXFP4-MTP (131K, spec decode)",
          "limit": { "context": 131072, "output": 16384 }
        },
        "qwen3.6-35b-a3b-mxfp4-mtp-64k": {
          "name": "Qwen3.6-35B A3B MXFP4-MTP (64K, spec decode)",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    },
    "llama-35b-nvfp4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Qwen3.6-35B A3B NVFP4 (Blackwell FP4, no MTP)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-nvfp4": {
          "name": "Qwen3.6-35B A3B NVFP4 (131K)",
          "limit": { "context": 131072, "output": 16384 }
        },
        "qwen3.6-35b-a3b-nvfp4-64k": {
          "name": "Qwen3.6-35B A3B NVFP4 (64K)",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    },
    "llama-nvfp4-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Qwen3.6-27B NVFP4-MTP (GGUF)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-27b-nvfp4-mtp-gguf": {
          "name": "Qwen3.6-27B NVFP4-MTP (131K GGUF, vision)",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 8192 }
        },
        "qwen3.6-27b-nvfp4-mtp-262k": {
          "name": "Qwen3.6-27B NVFP4-MTP (262K GGUF, vision)",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    },
    "llama-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Qwen3.6-27B Dense (Q4_K_XL)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen3.6-27B Dense (131K)",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "vllm-awq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM | Qwen3.6-27B AWQ INT4",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-27b-awq": {
          "id": "cyankiwi/Qwen3.6-27B-AWQ-INT4",
          "name": "Qwen3.6-27B AWQ (131K)",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    },
    "e4b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Gemma 4 E4B (Q4_K_XL, vision + thinking)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "e4b": {
          "name": "Gemma 4 E4B-it",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "gemma4-a4b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp | Gemma 4 26B A4B MoE (Q4_K_L imatrix)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "gemma4-26b": {
          "name": "Gemma 4 26B A4B",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "vllm-nvfp4-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM | Qwen3.6-27B NVFP4-MTP (n=3 spec decode)",
      "options": {
        "baseURL": "http://localhost:10500/v1"
      },
      "models": {
        "qwen3.6-27b-nvfp4-mtp": {
          "id": "sakamakismile/Qwen3.6-27B-Text-NVFP4-MTP",
          "name": "Qwen3.6-27B NVFP4-MTP (131K)",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    },
    "flux": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FLUX.1-schnell Image Generation",
      "options": {
        "baseURL": "http://localhost:10501"
      },
      "models": {
        "flux-schnell": {
          "name": "FLUX.1-schnell",
          "limit": { "context": 2048, "output": 2048 }
        }
      }
    }
  },
  "model": "llama-qwen/qwen3.6-27b",
  "permission": { "*": "allow" },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest",
                  "--executablePath", "/usr/bin/chromium",
                  "--chromeArg", "--no-sandbox"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "remote",
      "url": "http://localhost:8000/mcp"

  }
}
