#!/usr/bin/env bash
# Pre-commit hook: scan for secrets using gitleaks
# Exit 1 to prevent commit, exit 0 to allow

set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$STAGED" ]]; then
  echo "✓ No files to scan"
  exit 0
fi

echo "🔍 Scanning staged files for secrets..."

# Run gitleaks on staged files (scans file contents, not git history)
if ! echo "$STAGED" | xargs gitleaks detect --no-git --no-banner -v 2>&1; then
  echo "❌ Secrets detected — commit blocked"
  exit 1
fi

echo "✓ No secrets found"
exit 0
