[Unit]
Description=llama.cpp Router Mode (native model switching)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USERNAME__
Group=__USERNAME__

Environment="CUDA_VISIBLE_DEVICES=0"
Environment="GGML_CUDA_ENABLE_PEER_COPY=1"
Environment="LD_LIBRARY_PATH=/opt/llama-router/build/bin"
WorkingDirectory=/opt/llama-router/build

ExecStart=/opt/llama-router/build/bin/llama-server \
    --models-dir /opt/router-models \
    --models-autoload \
    --models-preset /opt/router-config/models.ini \
    --models-max 1 \
    --host 0.0.0.0 \
    --port 10500

Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

LimitNOFILE=65536
MemoryMax=30G
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
