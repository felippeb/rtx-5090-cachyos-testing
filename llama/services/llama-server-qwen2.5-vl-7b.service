[Unit]
Description=llama.cpp Inference Server (Qwen2.5-VL-7B-Instruct, Vision Model)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStartPre=+/usr/bin/nvidia-smi -pl 475
Type=simple
User=__USERNAME__
Group=__USERNAME__

Environment="CUDA_VISIBLE_DEVICES=0"
Environment="GGML_CUDA_ENABLE_PEER_COPY=1"
WorkingDirectory=/opt/qwen2.5-vl-7b/llama.cpp/build

ExecStart=/opt/qwen2.5-vl-7b/llama.cpp/build/bin/llama-server \
    -m /opt/qwen2.5-vl-7b/models/qwen2.5-vl-7b/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf \
    --mmproj /opt/qwen2.5-vl-7b/models/qwen2.5-vl-7b/mmproj-F16.gguf \
    -ngl 99 \
    -fa on \
    -c 32768 \
    -n 2048 \
    -np 1 \
    -b 2048 \
    -t 16 \
    -tb 16 \
    --temp 0.6 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.0 \
    --presence-penalty 1.5 \
    --repeat-penalty 1.0 \
    --host 0.0.0.0 \
    --port 10500

Restart=always
RestartSec=10

LimitNOFILE=65536
MemoryMax=20G
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
