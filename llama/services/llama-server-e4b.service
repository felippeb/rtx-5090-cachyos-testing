[Unit]
Description=llama.cpp Inference Server (Gemma 4 E4B, 128K vision + thinking)
After=network-online.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
ExecStartPre=+/usr/bin/nvidia-smi -pl 475
Type=simple
User=__USERNAME__
Group=__USERNAME__
ExecStart=/opt/e4b/llama.cpp/build/bin/llama-server \
    -m /opt/e4b/models/e4b/google_gemma-4-E4B-it-Q4_K_L.gguf \
    --mmproj /opt/e4b/models/e4b/mmproj-F16.gguf \
    --host 0.0.0.0 \
    --port 10500 \
    -c 131072 \
    -ctk q4_1 \
    -ctv q4_1 \
    --temp 0.7 \
    --top-p 0.95 \
    --top-k 64 \
    --chat-template-kwargs '{"preserve_thinking": true}' \
    --log-disable \
    -ngl 99 \
    -fa on \
    -b 8192

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server-e4b

# GPU access
Group=__USERNAME__
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
