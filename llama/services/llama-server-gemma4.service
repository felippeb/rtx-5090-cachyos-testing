[Unit]
Description=llama.cpp Inference Server (Gemma 4 31B, Regular)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStartPre=+/usr/bin/nvidia-smi -pl 475
Type=simple
User=__USERNAME__
Group=__USERNAME__

Environment="CUDA_VISIBLE_DEVICES=0"
Environment="GGML_CUDA_ENABLE_PEER_COPY=1"
WorkingDirectory=/opt/llama.cpp/build

ExecStart=/opt/llama.cpp/build/bin/llama-server \
    -m /opt/models/gemma4-31b/gemma-4-31B-it-UD-Q4_K_XL.gguf \
    --mmproj /opt/models/gemma4-31b/mmproj-F16.gguf \
    -ngl 99 \
    -fa on \
    -c 131072 \
    -np 1 \
    -b 8192 \
    -t 16 \
    -tb 16 \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 64 \
    --chat-template-kwargs '{"preserve_thinking": true}' \
    -ctk bf16 \
    -ctv bf16 \
    --host 0.0.0.0 \
    --port 10500

Restart=always
RestartSec=10

LimitNOFILE=65536
MemoryMax=20G
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
