[Unit]
Description=llama.cpp Inference Server (Gemma 4 31B MTP, 262K + TurboQuant)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USERNAME__
Group=__USERNAME__

Environment="CUDA_VISIBLE_DEVICES=0"
Environment="GGML_CUDA_ENABLE_PEER_COPY=1"
WorkingDirectory=/opt/llama.cpp-gemma4-mtp/build

ExecStart=/opt/llama.cpp-gemma4-mtp/build/bin/llama-server \
    -m /opt/models-gemma4-mtp/gemma4-31b-it/gemma-4-31B-it-UD-Q4_K_XL.gguf \
    --mtp-head /opt/models-gemma4-mtp/gemma4-31b-it-assistant/gemma-4-31B-it-assistant.Q4_K_M.gguf \
    --spec-type mtp \
    --draft-block-size 3 \
    --draft-max 8 \
    --draft-min 0 \
    -ngl 99 -ngld 99 \
    -ctk turbo3 -ctv turbo3 -ctkd turbo3 -ctvd turbo3 \
    -fa on \
    -c 262144 \
    -n 8192 \
    -np 1 \
    -t 16 \
    -tb 16 \
    --temp 0.3 \
    --top-p 0.95 \
    --top-k 64 \
    --chat-template-kwargs '{"preserve_thinking": true}' \
    --host 0.0.0.0 \
    --port 10500

Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

LimitNOFILE=65536
MemoryMax=20G
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
