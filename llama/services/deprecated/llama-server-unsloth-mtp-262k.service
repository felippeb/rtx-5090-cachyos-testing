[Unit]
Description=llama.cpp Inference Server (Qwen3.6-27B Unsloth MTP, 262K vision + MTP)
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStartPre=+/usr/bin/nvidia-smi -pl 475
Type=simple
User=__USERNAME__
Group=__USERNAME__

Environment="CUDA_VISIBLE_DEVICES=0"
Environment="GGML_CUDA_ENABLE_PEER_COPY=1"
Environment="LD_LIBRARY_PATH=/opt/llama.cpp/build/bin"
WorkingDirectory=/opt/llama.cpp/build

ExecStart=/opt/llama.cpp/build/bin/llama-server \
    -m /opt/models/qwen3.6-27b-mtp-unsloth/Qwen3.6-27B-UD-Q4_K_XL.gguf \
    --mmproj /opt/models/qwen3.6-27b-mtp-unsloth/mmproj-F16.gguf \
    -fitt 5120 \
    -c 262144 \
    -n 32768 \
    -fa on \
    -ngl 99 \
    -np 1 \
    -t 16 \
    -tb 16 \
    -ctk q4_1 \
    -ctv q4_1 \
    -ctkd q4_1 \
    -ctvd q4_1 \
    -ctxcp 16 \
    -cram 4096 \
    --cache-idle-slots \
    --no-warmup \
    --spec-type draft-mtp \
    --spec-draft-n-max 2 \
    --temp 0.6 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.0 \
    --presence-penalty 1.5 \
    --repeat-penalty 1.0 \
    --host 0.0.0.0 \
    --port 10500

Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

LimitNOFILE=65536
MemoryMax=20G
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
