[Unit]
Description=Free Claude Code Proxy (llama.cpp backend)
After=network.target llama-server.service
Wants=llama-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USERNAME__
Group=__USERNAME__

EnvironmentFile=__HOMEDIR__/repos/free-claude-code/.env
WorkingDirectory=__HOMEDIR__/repos/free-claude-code

ExecStart=__HOMEDIR__/repos/free-claude-code/.venv/bin/uvicorn \
    server:app \
    --host 0.0.0.0 \
    --port 8082

Restart=on-failure
RestartSec=10

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
